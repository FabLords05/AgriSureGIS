# Used only by `npm run build` (not `npm run dev`) for the public Tailscale
# Funnel deployment -- see deploy/Caddyfile. No secrets here; this file is committed.

# Empty = same origin: the built app calls /api/... on whatever address it was
# loaded from, and Caddy forwards that to FastAPI.
VITE_API_BASE_URL=

# Only switches the GeoServer overlay on; the browser itself always goes
# through /geoserver-proxy, which Caddy forwards to GeoServer.
VITE_GEOSERVER_URL=http://localhost:8080/geoserver
