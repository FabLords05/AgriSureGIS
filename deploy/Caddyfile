# AgriSureGIS - public deployment through Tailscale Funnel.
#
# Funnel (https://<pc>.<tailnet>.ts.net, port 443) forwards every request to
# this Caddy instance on 127.0.0.1:8090, which splits them up so the browser
# sees a single origin (no CORS needed):
#   /api/*                         -> FastAPI (uvicorn, 127.0.0.1:8000)
#   /geoserver-proxy/agrisuregis/* -> GeoServer workspace only (127.0.0.1:8080);
#                                     the GeoServer admin UI is never exposed
#   everything else                -> the built frontend (frontend/dist)
# FastAPI's /docs and /openapi.json are deliberately not routed.
#
# Run from the repo root (start-servers.bat prod does this) so the relative
# frontend/dist path below resolves:  caddy run --config deploy/Caddyfile
# See .claude/LOCAL_SERVER_SETUP.md section 9.

{
	admin off
	auto_https off
}

:8090 {
	bind 127.0.0.1
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Replaces Vite's dev-only /geoserver-proxy (vite.config.ts) for the built app.
	handle /geoserver-proxy/agrisuregis/* {
		uri replace /geoserver-proxy/ /geoserver/ 1
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		# Revalidate everything except Vite's content-hashed /assets/* on every
		# load, so a redeploy reaches the installed PWA on its next launch.
		# Matched on the request path, not the file served: header runs before
		# try_files, so SPA routes falling back to index.html are covered too.
		# Unchanged files still come back as a cheap 304.
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
		root * frontend/dist
		try_files {path} /index.html
		file_server
	}
}
