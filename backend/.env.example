# Copy this file to backend/.env (gitignored, never commit it) and adjust as needed.
# See .claude/ENV_GUIDE.md for the full variable reference.

# PostGIS database connection string.
# Format: postgresql://user:password@host:port/dbname
# Default below matches the shared team setup (localhost:5432). Only override
# this if your local Postgres runs elsewhere (e.g. a different port).
DATABASE_URL=postgresql://agrisure_admin:agrisure_password@localhost:5432/agrisure_db
