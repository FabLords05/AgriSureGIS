# Copy this file to backend/.env and fill in real values.
# See .claude/ENV_GUIDE.md for the full description of each variable.
# Never commit backend/.env (it's already gitignored).

# PostGIS database connection string. Provided by Fabio (DB Admin).
DATABASE_URL=postgresql://agrisure_admin:your_password_here@localhost:5432/agrisure_db

# REQUIRED -- signs/verifies login session tokens (app/core/security.py).
# Unlike DATABASE_URL above, there is deliberately NO insecure hardcoded
# fallback for this one -- the backend refuses to start without it. Generate
# a real random value yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a value that's ever been committed/shared anywhere.
JWT_SECRET_KEY=

# Optional -- GET /api/farms/'s page cache (app/core/farms_cache.py). Unset
# or empty means caching is a no-op; nothing else changes. Leave blank
# unless you're actually running a Redis server locally.
REDIS_URL=

# PAGASA Tropical Cyclone Bulletin webpage URL.
PAGASA_SCRAPE_URL=

# SMTP server settings for email alerts (backend/app/services/email_alert_service.py).
# Unset SMTP_HOST/SMTP_USER/SMTP_PASSWORD = alerts are a no-op, same as REDIS_URL above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional From address. Unset = SMTP_USER (fine for Gmail). Required for Brevo:
# SMTP_USER is Brevo's generated SMTP login, so set this to a sender address
# verified in Brevo (e.g. SMTP_HOST=smtp-relay.brevo.com).
SMTP_FROM=

# Optional -- Google Earth Engine service-account key for SAR planted
# verification (backend/app/services/gee_sar_service.py). Path to the JSON key
# file (webgis-pcic-*.json, gitignored -- a live private key, never commit it).
# Unset = the SAR layer is a no-op (503 "not configured"); nothing else changes.
# Also needs earthengine-api installed (backend/requirements.txt).
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Optional -- the separate archive database (backend/archive_schema.sql).
# Unset = archive endpoints return 503 and Archive & Clear is unavailable.
ARCHIVE_DATABASE_URL=
ARCHIVE_WRITER_DATABASE_URL=

# Optional -- database backups (backend/app/services/backup_service.py).
# pg_dump/pg_restore must match the server's major version.
PG_DUMP_PATH=
PG_RESTORE_PATH=
BACKUP_DIR=
# Local manual/scheduled .dump files kept (newest first); default 30.
BACKUP_RETENTION_COUNT=30
# Google Drive off-site copy (personal Gmail OAuth; see scripts/gdrive_authorize.py).
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
# Encrypts the Google Drive copy (AES-256-GCM). base64 of 32 random bytes:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every encrypted Drive copy unreadable -- keep a copy offline.
BACKUP_ENCRYPTION_KEY=
# A SEPARATE, disposable database that "Verify" restores backups into and
# checks. Never the live database (refused). Its contents are replaced.
BACKUP_VERIFY_DATABASE_URL=
